<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-50 text-gray-800 font-sans p-8">
    <div class="max-w-5xl mx-auto">
        <h1 class="text-4xl font-extrabold text-center text-orange-600 mb-10"><%= title %></h1>
        
        <!-- Grid UI Baru -->
        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6">
            <% products.forEach(product => { %>
                <!-- Card Container -->
                <div class="bg-white rounded-2xl shadow-sm hover:shadow-xl transition-all duration-300 overflow-hidden border border-gray-100 flex flex-col">
                    
                    <!-- Area Gambar -->
                    <img src="<%= product.gambar %>" alt="<%= product.nama %>" class="w-full h-48 object-cover">
                    
                    <!-- Area Teks -->
                    <div class="p-5 flex flex-col flex-grow">
                        <span class="text-xs font-bold uppercase tracking-wider text-orange-500 mb-2"><%= product.kategori %></span>
                        <h2 class="text-lg font-bold text-gray-800 mb-2 leading-tight"><%= product.nama %></h2>
                        
                        <!-- Mengisi ruang kosong agar harga selalu di bawah -->
                        <div class="flex-grow"></div> 
                        
                        <p class="text-xl font-extrabold text-green-600 mt-4">Rp <%= product.harga.toLocaleString('id-ID') %></p>
                        
                        <!-- Tambahan Tombol Pesan (UI Opsional) -->
                        <button class="mt-4 w-full bg-orange-500 hover:bg-orange-600 text-white font-semibold py-2 px-4 rounded-xl transition-colors">
                            Pesan
                        </button>
                    </div>
                </div>
            <% }) %>
        </div>
    </div>
</body>
</html>